{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口的权限",
  "windows": ["main"],
  "permissions": [
    "main-commands",
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "dialog:allow-message",
    "drag:allow-start-drag",
    "opener:allow-reveal-item-in-dir"
  ]
}

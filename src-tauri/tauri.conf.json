{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "表情管理器",
  "mainBinaryName": "sticker-manager",
  "version": "0.1.6",
  "identifier": "com.wjiajian.sticker-manager",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/objects/*", "$APPDATA/thumbs/*"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg2QjdDN0E2NUFEMEQyQkUKUldTKzB0QmFwc2UzaG9abW55eFluREpWekhFS2hsSFdyTDVYMzBkRWdTNS8zZ2V0YVdjTmwwUDMK",
      "endpoints": ["https://github.com/wjiajian/sticker-manager/releases/latest/download/latest.json"],
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": { "language": "zh-CN" },
      "nsis": { "languages": ["SimpChinese"] }
    }
  }
}

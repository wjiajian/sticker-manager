---
interface Props {
  src: string;
  copied?: boolean;
}

// 表情面板里的一格，用在静态的首屏演示里。可点击的演示见 TryPanel.astro。
const { src, copied = false } = Astro.props;
---

<div class="tile" data-copied={copied ? '' : undefined}>
  <img src={src} alt="" width="80" height="80" loading="lazy" />
  {copied && <span class="tile-badge">已复制</span>}
</div>
